{
    "dryRun": false,
    "playerUrl": "https://painelribas.com.br/",
    "localAgentHealthUrl": "http://localhost:3579/health",
    "agentTaskName": "PainelRibasPlayerAgent",
    "kioskTaskName": "PainelRibasChromeKiosk",
    "computerNamePattern": "PAINEL-TV",
    "enableNodeInstall": true,
    "enableAgentSetup": true,
    "enablePowerTweaks": true,
    "enableKioskTask": true,
    "enableCleanup": true,
    "enableAnyDeskCheck": true,
    "reportFolder": "relatorios",
    "node": {
        "installMethod": "winget",
        "wingetPackageId": "OpenJS.NodeJS.LTS"
    },
    "agent": {
        "relativeInstallScript": "..\\player-agent\\scripts\\instalar-tarefa-agent.bat",
        "relativeConfigPath": "..\\player-agent\\config.agent.json",
        "expectedServerBaseUrl": "https://painelribas.com.br",
        "runTaskAfterInstall": true,
        "healthTimeoutSeconds": 5,
        "healthRetrySeconds": 5
    },
    "power": {
        "setHighPerformance": true,
        "disableHibernate": true,
        "acMonitorTimeoutMinutes": 0,
        "acStandbyTimeoutMinutes": 0,
        "acDiskTimeoutMinutes": 0
    },
    "kiosk": {
        "delaySeconds": 20,
        "chromeUserDataDir": "C:\\PainelRibas\\chrome-profile",
        "arguments": [
            "--kiosk",
            "--start-fullscreen",
            "--autoplay-policy=no-user-gesture-required",
            "--disable-session-crashed-bubble",
            "--disable-infobars",
            "--no-first-run",
            "--disable-translate",
            "--disable-features=Translate,TranslateUI",
            "--lang=pt-BR",
            "--accept-lang=pt-BR,pt,en-US,en"
        ]
    }
}