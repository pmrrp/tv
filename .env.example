PORT=3000
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-este-segredo
NODE_ENV=development

# =========================================================
# ARMAZENAMENTO / FASE 3
# =========================================================
# Limite máximo recomendado para a pasta de mídias.
# O sistema usa esse valor para alertar/bloquear uploads
# antes que a pasta midia/ ocupe espaço demais no servidor.
MEDIA_MAX_STORAGE_GB=180

# Espaço mínimo livre que deve ser preservado no disco.
# Isso evita que uploads consumam todo o disco da VM e prejudiquem
# Windows, banco SQLite, backups, logs e o próprio servidor Node.
DISK_MIN_FREE_GB=50

# =========================================================
# URL PÚBLICA DO SISTEMA
# =========================================================
# Usada para gerar links externos, como recuperação de senha.
#
# Local:
# APP_BASE_URL=http://localhost:3000
#
# Produção temporária:
# APP_BASE_URL=https://painelribas.com.br
#
# Produção institucional futura:
# APP_BASE_URL=https://tv.ribasdoriopardo.ms.gov.br
APP_BASE_URL=http://localhost:3000

# =========================================================
# RECUPERAÇÃO DE SENHA
# =========================================================
# Tempo de validade do link de recuperação de senha.
PASSWORD_RESET_TOKEN_MINUTES=30

# Tempo de retenção de tokens antigos de recuperação de senha.
# Tokens usados/expirados há mais que esse número de dias serão removidos.
PASSWORD_RESET_TOKEN_RETENTION_DAYS=7

# =========================================================
# E-MAIL / SMTP
# =========================================================
# Configurações usadas para envio de e-mails do sistema,
# como recuperação de senha.
#
# Enquanto SMTP_HOST/MAIL_FROM não forem configurados, o sistema
# não envia e-mail e mostra o link de recuperação apenas no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Painel TV Ribas <painel-tv@ribasdoriopardo.ms.gov.br>"

# Método de autenticação SMTP.
# Deixe vazio para automático.
# Alguns servidores aceitam melhor LOGIN do que PLAIN.
SMTP_AUTH_METHOD=

# Força STARTTLS em conexões SMTP na porta 587.
SMTP_REQUIRE_TLS=false

# Nome esperado no certificado TLS.
# Útil quando o host do domínio aponta para um servidor com certificado de outro nome.
# Exemplo: smtp.email-ssl.com.br
SMTP_TLS_SERVERNAME=

# Validação de certificado TLS.
# Manter true em produção.
# Usar false apenas para diagnóstico temporário de certificado.
SMTP_TLS_REJECT_UNAUTHORIZED=true